# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
# テスト用（秘密情報を含まない。ローカルの捨て DB のみ）
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma（生成物。pnpm prisma generate で作る）
/src/generated/

# 開発モードのメール出力（確認リンクの控え）
.dev-mail.log

# デモ用ダミーデータの ID（--undo で使う。環境ごとに異なる）
.seed-demo-ids.json
