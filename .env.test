# テスト専用の環境変数。**ローカルの捨て DB だけを指す。**
# ./scripts/test-db.sh up が立てるコンテナに合わせてある。
#
# このファイルはコミットする（秘密情報を含まない）。
# src/test/setup.ts が localhost 以外を指していたらテストを止める。

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/monely_test"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55432/monely_test"
BETTER_AUTH_SECRET="test-secret-not-used-for-anything-real"
BETTER_AUTH_URL="http://localhost:3000"

# テストも JST 固定にして、日付の判定を本番と揃える
TZ="Asia/Tokyo"
