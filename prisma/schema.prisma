// Monely のスキーマ定義。
// 設計意図は docs/02-design/database-design.md を参照。
//
// 認可はこのスキーマでは表現しない。すべて src/lib/data/ の Data Access Layer で
// 世帯 ID で絞る（docs/05-decisions/ADR-0005-authorization-in-app-layer.md）。
//
// 認証も Prisma で管理する（better-auth）。user / session / account / verification は
// better-auth が使うテーブルで、形は getAuthTables() が返す定義に一致させている。
// → docs/05-decisions/ADR-0007-better-auth.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 支出 / 収入。金額の符号では表さず、この種別で向きを表す
enum Kind {
  expense
  income

  @@map("kind")
}

/// 家計簿を共有する単位。UI では「わが家」と呼ぶ
model Household {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @db.VarChar(30)
  /// 6 桁の英数字（大文字）。家族の参加に使う。世帯の全データへのアクセス権と同等に扱う
  inviteCode String   @unique @map("invite_code") @db.VarChar(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profiles     Profile[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]

  @@map("households")
}

/// 世帯のメンバー。Supabase Auth のユーザーと 1:1
model Profile {
  id String @id @default(uuid(7)) @db.Uuid
  /// better-auth の User.id。同じ Prisma 管理下なので外部キーを張れる
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String   @map("display_name") @db.VarChar(20)
  /// null = まだ世帯に未所属（セットアップ前）。これは正式な状態
  householdId String?  @map("household_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  household           Household?    @relation(fields: [householdId], references: [id], onDelete: SetNull)
  paidTransactions    Transaction[] @relation("paidBy")
  createdTransactions Transaction[] @relation("createdBy")

  @@index([householdId])
  @@map("profiles")
}

/// 支出用・収入用に分かれる。世帯ごとに持つ
model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  kind        Kind
  name        String   @db.VarChar(20)
  /// 表示順。「その他」は 999 で末尾に固定
  sortOrder   Int      @default(0) @map("sort_order")
  /// true = 新規登録の選択肢から外す。既存の記録には残る。削除はしない
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([householdId, kind, name])
  @@index([householdId, kind, sortOrder])
  @@map("categories")
}

/// 収支 1 件
/// カテゴリごとの月予算（FR-B1〜B3 / ADR-0011）。
/// **毎月同じ額が適用される。** 月ごとに違う額を持たせるなら
/// (household_id, category_id, month) の複合キーに変える。
model Budget {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// DAL の where で必ず指定する。認可の要
  householdId String   @map("household_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  /// 円。1 以上の整数。0 は「予算なし」として行を消す
  amount      Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// 1 カテゴリに 1 件。世帯も入れて、他世帯のカテゴリと衝突しないようにする
  @@unique([householdId, categoryId])
  @@map("budgets")
}

model Transaction {
  id String @id @default(uuid(7)) @db.Uuid
  /// DAL の where で必ず指定する。認可の要
  householdId String @map("household_id") @db.Uuid
  /// いつの支出か。date 型で時刻を持たない（タイムゾーンで日がずれないように）
  occurredOn  DateTime @map("occurred_on") @db.Date
  kind        Kind
  /// 円。1 以上の整数。CHECK 制約はマイグレーションの SQL で追加する（Prisma schema では表現できない）
  amount      Int
  categoryId  String?  @map("category_id") @db.Uuid
  /// 支払った人。メンバーが抜けても記録は残す
  paidById    String?  @map("paid_by") @db.Uuid
  memo        String?  @db.VarChar(200)
  /// 入力した人。DAL でセッションから埋める。引数で受け取らない
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paidBy    Profile?  @relation("paidBy", fields: [paidById], references: [id], onDelete: SetNull)
  createdBy Profile   @relation("createdBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId, occurredOn(sort: Desc), createdAt(sort: Desc)])
  @@map("transactions")
}

// -----------------------------------------------------------------------------
// better-auth が使うテーブル。
//
// 形は `getAuthTables()`（better-auth 1.7.18）が返す定義にそのまま合わせている。
// **better-auth を上げるときは getAuthTables() の出力と突き合わせること。**
//   node -e 'import("better-auth/db").then(m => console.log(m.getAuthTables(options)))'
//
// テーブル名は better-auth の既定（単数形）に @@map で合わせる。
// 他のモデルは snake_case の複数形だが、ここは既定に従うほうが追従しやすい。
// -----------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  /// Monely 側のドメインモデル（表示名・所属世帯）
  profile Profile?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// 認証手段。メール + パスワードの場合 providerId = "credential" で password にハッシュが入る
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// メール確認・パスワード再設定・マジックリンクのトークン
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
