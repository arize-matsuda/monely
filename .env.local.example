# Supabase の設定値。.env.local にコピーして使う（.env.local はコミットしない）
# 取得場所: Supabase ダッシュボード → Project Settings → API Keys
#   URL             … Project URL
#   PUBLISHABLE_KEY … Publishable key（sb_publishable_... で始まる公開可能なキー）

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# secret key（旧 service_role キー）は絶対に使わない。
# RLS を完全にバイパスするため、設計の前提（認可を DB に置く）が崩れる。
# → docs/05-decisions/ADR-0002-authorization-via-rls.md
