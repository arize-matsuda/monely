# Monely の環境変数。.env.local にコピーして使う（.env.local はコミットしない）
# Next.js と Prisma CLI がどちらも .env.local を読む

# --- Prisma（DB 接続）------------------------------------------------------
# 取得場所: Supabase ダッシュボード → Project Settings → Connect
#
# DATABASE_URL … Transaction pooler（ポート 6543, pgbouncer=true）。アプリの通常のクエリ用
# DIRECT_URL   … Session pooler（ポート 5432）。マイグレーション用。
#                Transaction pooler ではマイグレーションがハングする（実測）
#
# どちらも DB の全権を持つ。NEXT_PUBLIC_ を絶対に付けない。
DATABASE_URL=
DIRECT_URL=

# --- タイムゾーン ----------------------------------------------------------
# **このアプリは単一タイムゾーン（JST）を前提にする。**
# 「今日 / 昨日」の判定をサーバーで行うため、サーバーの時計が JST である必要がある。
# 本番（Vercel など）は既定が UTC なので、必ず設定する。
TZ=Asia/Tokyo

# --- better-auth（認証）----------------------------------------------------
# BETTER_AUTH_SECRET … セッションの署名鍵。次のコマンドで作る:
#     node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   **これが漏れるとセッションを偽造できる。** NEXT_PUBLIC_ を付けない。
BETTER_AUTH_SECRET=
# アプリの URL。**仮の値を入れない。** 不正な値だと起動時に落ちる
# （better-auth が URL として検証する。実際に `e` を入れて落ちた）。
#
# 空欄でよい。その場合は次の順で決まる:
#   1. Vercel の本番ドメイン（VERCEL_PROJECT_PRODUCTION_URL、自動で渡る）
#   2. http://localhost:3000
# 独自ドメインを使うときだけ明示する（例: https://monely.example.com）
BETTER_AUTH_URL=http://localhost:3000

# --- メール送信 ------------------------------------------------------------
# 未設定なら開発モード（確認リンクを**サーバーのコンソールに出力**する）。
# 家族を招待する前に設定する。
# Resend: https://resend.com → API Keys
RESEND_API_KEY=
# 送信元アドレス。Resend で検証したドメインのもの（例: Monely <no-reply@example.com>）
MAIL_FROM=
