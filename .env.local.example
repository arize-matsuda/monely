# Monely の環境変数。.env.local にコピーして使う（.env.local はコミットしない）
# Next.js と Prisma CLI がどちらも .env.local を読む

# --- Prisma（DB 接続）------------------------------------------------------
# 取得場所: Supabase ダッシュボード → Project Settings → Connect
#
# DATABASE_URL … Transaction pooler（ポート 6543, pgbouncer=true）。アプリの通常のクエリ用
# DIRECT_URL   … Session pooler（ポート 5432）。マイグレーション用。
#                Transaction pooler ではマイグレーションがハングする（実測）
#
# どちらも DB の全権を持つ。NEXT_PUBLIC_ を絶対に付けない。
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth ---------------------------------------------------------
# 取得場所: Supabase ダッシュボード → Project Settings → API Keys
#   URL             … Project URL
#   PUBLISHABLE_KEY … Publishable key（sb_publishable_... で始まる公開可能なキー）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key（旧 service_role キー）は使わない。
# → docs/05-decisions/ADR-0005-authorization-in-app-layer.md
